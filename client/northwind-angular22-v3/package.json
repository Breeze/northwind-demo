    "@angular/router": "^22.2.3",
    "breeze-client": "^3.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
